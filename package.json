{
  "name": "ahadi",
  "version": "1.0.0",
  "private": true,
  "description": "AHADI — Universal Commitment & Trust Network",
  "author": "AHADI Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter './apps/**' build",
    "build:api": "pnpm --filter @ahadi/api build",
    "build:worker": "pnpm --filter @ahadi/worker build",
    "dev": "pnpm --filter @ahadi/api dev",
    "dev:worker": "pnpm --filter @ahadi/worker dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:worker\"",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --filter @ahadi/api test:unit",
    "test:integration": "pnpm --filter @ahadi/api test:integration",
    "test:e2e": "pnpm --filter @ahadi/api test:e2e",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,json,md}\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @ahadi/database db:generate",
    "db:migrate": "pnpm --filter @ahadi/database db:migrate",
    "db:migrate:prod": "pnpm --filter @ahadi/database db:migrate:prod",
    "db:studio": "pnpm --filter @ahadi/database db:studio",
    "db:seed": "pnpm --filter @ahadi/database db:seed",
    "db:reset": "pnpm --filter @ahadi/database db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "prisma": "5.22.0",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/passport-local": "^1.0.38",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "passport-local": "^1.0.0",
    "pino-pretty": "^13.1.3"
  }
}
