# ============================================================
# AHADI Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=ahadi
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4000
ADMIN_URL=http://localhost:5000

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://ahadi:ahadi_dev_pass@localhost:5432/ahadi_dev?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Object Storage (S3-compatible) ───────────────────────────
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_EVIDENCE=ahadi-evidence
STORAGE_BUCKET_AVATARS=ahadi-avatars
STORAGE_BUCKET_DOCUMENTS=ahadi-documents
STORAGE_ACCESS_KEY=ahadi_minio_key
STORAGE_SECRET_KEY=REPLACE_WITH_MINIO_SECRET

# ── Email Provider ───────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ahadi.app
EMAIL_FROM_NAME=AHADI

# ── SMS Provider ─────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_MOCK_LOG=true
# BONGOSMS_API_KEY=
# BONGOSMS_SENDER_ID=AHADI
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=

# ── Payment Providers ────────────────────────────────────────
PAYMENT_PROVIDER_DEFAULT=mock
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
# TIGOPESA_USERNAME=
# TIGOPESA_PASSWORD=
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

# ── AI Provider ──────────────────────────────────────────────
AI_PROVIDER=mock
AI_MOCK_DELAY_MS=200
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-1.5-pro

# ── Feature Flags ────────────────────────────────────────────
FEATURE_AI_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_ESCROW_ENABLED=false
FEATURE_FINANCIAL_PASSPORT_ENABLED=false
FEATURE_GROUPS_ENABLED=true
FEATURE_BUSINESS_VERIFICATION_ENABLED=true
FEATURE_DISPUTE_ENABLED=true

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=
# Set in production:
# SENTRY_ENVIRONMENT=production

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=300000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000

# ── Security ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5000
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
SESSION_EXPIRY_DAYS=30

# ── Worker ───────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_MAX_STALENESS_MS=30000
OUTBOX_POLL_INTERVAL_MS=1000
COMMITMENT_MONITOR_CRON=*/5 * * * *
TRUST_SNAPSHOT_CRON=0 2 * * *

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
UPLOAD_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
