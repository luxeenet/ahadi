// =============================================================================
// AHADI — Prisma Schema
// Database: PostgreSQL 16
// ORM: Prisma 5
//
// Design principles:
//   - ULID identifiers (application-generated, sortable)
//   - UTC timestamps everywhere
//   - Immutable append-only tables for audit, ledger, events
//   - Soft deletes (deletedAt) ONLY for user-facing entities
//   - Financial and audit records are NEVER deleted
//   - Foreign keys enforced at DB level
//   - JSONB for flexible metadata (not for queryable business fields)
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum OtpPurpose {
  VERIFY_PHONE
  VERIFY_EMAIL
  LOGIN
  RESET_PASSWORD
  MFA
}

enum VerificationLevel {
  UNVERIFIED
  BASIC_VERIFIED
  IDENTITY_VERIFIED
  BUSINESS_VERIFIED
  TRANSACTION_VERIFIED
  PROFESSIONAL_VERIFIED
}

enum VisibilityScope {
  PRIVATE
  PARTICIPANTS_ONLY
  GROUP_ONLY
  VERIFIED_PARTNERS
  PUBLIC
}

enum BusinessMemberRole {
  OWNER
  ADMIN
  EMPLOYEE
  VIEWER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING_REVIEW
  CLOSED
}

enum BusinessVerificationType {
  PHONE
  EMAIL
  BUSINESS_REGISTRATION
  TAX
  ADDRESS
  BANK_ACCOUNT
  PROFESSIONAL_CERTIFICATE
  IDENTITY
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REVOKED
}

enum GroupType {
  SAVINGS
  COMMUNITY
  PROJECT
  SPORTS
  BUSINESS
  EVENT
  CUSTOM
}

enum GroupMemberRole {
  OWNER
  ADMIN
  TREASURER
  MODERATOR
  MEMBER
  VIEWER
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum CommitmentCategory {
